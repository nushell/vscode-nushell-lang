{
  "name": "vscode-nushell-lang",
  "displayName": "vscode-nushell-lang",
  "description": "nushell language for vscode",
  "author": "The Nushell Project Developers",
  "version": "2.0.6",
  "preview": false,
  "license": "MIT",
  "publisher": "TheNuProjectContributors",
  "homepage": "https://www.nushell.sh/",
  "repository": {
    "type": "git",
    "url": "https://github.com/nushell/vscode-nushell-lang.git"
  },
  "bugs": {
    "url": "https://github.com/nushell/vscode-nushell-lang/issues"
  },
  "engines": {
    "vscode": "^1.110.0",
    "node": ">=20"
  },
  "icon": "assets/nushell.ico",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:nushell"
  ],
  "main": "out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nushell",
        "aliases": [
          "nushell",
          "nu"
        ],
        "extensions": [
          ".nu"
        ],
        "icon": {
          "light": "assets/nu.svg",
          "dark": "assets/nu.svg"
        },
        "firstLine": "^#!\\s*/?.*\\bnu\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nushell",
        "scopeName": "source.nushell",
        "path": "./syntaxes/nushell.tmLanguage.json"
      },
      {
        "scopeName": "markdown.nushell.codeblock",
        "path": "./syntaxes/codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nushell": "nushell"
        }
      }
    ],
    "keybindings": [
      {
        "command": "nushell.openDocs",
        "key": "ctrl+f1",
        "when": "editorTextFocus && editorLangId == 'nushell'"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+alt+j",
        "when": "editorTextFocus && editorLangId == 'nushell'",
        "mac": "cmd+alt+j",
        "win": "ctrl+alt+j",
        "linux": "ctrl+alt+j"
      }
    ],
    "snippets": [
      {
        "language": "nushell",
        "path": "./snippets/nushell.json"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "title": "Nushell",
          "id": "nushell_default"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Nushell IDE Support",
      "properties": {
        "nushellLanguageServer.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Traces the communication between VS Code and the language server."
        },
        "nushellLanguageServer.nushellExecutablePath": {
          "scope": "resource",
          "type": "string",
          "default": "nu",
          "description": "Path to the `nu` executable used by the language server, the terminal profile and the debugger. When left at `nu`, the extension uses `nu` from PATH."
        },
        "nushellDebugger.restartOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Hot restart: automatically restart the active Nushell debug session when you save the script being debugged. Auto-saves are ignored. The script re-runs from disk with breakpoints intact (state resets; side effects run again)."
        },
        "nushellDebugger.timeTravel": {
          "type": "boolean",
          "default": true,
          "description": "Time-travel debugging: record execution history so Step Back / Reverse Continue can revisit any line the script ran through (not just breakpoints). Records a lightweight state snapshot per line; turn off to record only at stops if a very hot loop makes recording costly."
        },
        "nushellDebugger.timeTravelMaxSteps": {
          "type": "number",
          "default": 10000,
          "description": "Maximum number of recorded steps kept for time travel (a ring buffer). Older steps are dropped once the limit is reached, so Reverse can go back at most this many steps."
        },
        "nushellDebugger.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log every Debug Adapter Protocol message between VS Code and `nu --dap` to the \"Nushell Debug\" output channel. Useful when a debug session hangs: the request without a response shows what the adapter is stuck on. Applies to sessions started after changing it."
        }
      }
    },
    "commands": [
      {
        "command": "nushell.openDocs",
        "title": "Nushell: Open Documentation"
      },
      {
        "command": "nushell.stopLanguageServer",
        "title": "Nushell: Stop Language Server"
      },
      {
        "command": "nushell.startLanguageServer",
        "title": "Nushell: Start Language Server"
      },
      {
        "command": "nushell-debug.showIr",
        "title": "Nushell Debug: Show IR",
        "icon": "$(file-binary)"
      },
      {
        "command": "nushell-debug.visualizeVariable",
        "title": "Visualize"
      }
    ],
    "breakpoints": [
      {
        "language": "nushell"
      }
    ],
    "debuggers": [
      {
        "type": "nushell",
        "label": "Nushell Debug",
        "languages": [
          "nushell"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .nu script to debug. A relative path is resolved against cwd.",
                "default": "${file}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory ($env.PWD) for the script.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the entry point (`main`, or `entryPoint`). When omitted and the entry point has required parameters, you are prompted for them at launch.",
                "default": []
              },
              "entryPoint": {
                "type": "string",
                "description": "For a script without a `main`: the command to call after the script has loaded. When omitted you are asked to pick one (or to run the script top-to-bottom)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first instruction.",
                "default": false
              },
              "timeTravel": {
                "type": "boolean",
                "description": "Record execution history for Step Back / Reverse Continue. Defaults to the `nushellDebugger.timeTravel` setting."
              },
              "timeTravelMaxSteps": {
                "type": "number",
                "description": "Maximum number of recorded steps kept for time travel. Defaults to the `nushellDebugger.timeTravelMaxSteps` setting."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nushell",
            "request": "launch",
            "name": "Debug nu script",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Nushell: Launch current file",
            "body": {
              "type": "nushell",
              "request": "launch",
              "name": "Debug ${1:script}.nu",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nushell-debug.showIr",
          "when": "editorLangId == nushell && debugType == 'nushell'",
          "group": "navigation"
        }
      ],
      "debug/variables/context": [
        {
          "command": "nushell-debug.visualizeVariable",
          "when": "debugType == 'nushell'"
        }
      ],
      "commandPalette": [
        {
          "command": "nushell-debug.visualizeVariable",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm run compile",
    "esbuild-base": "npx esbuild client/src/extension.ts --bundle --outdir=out --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap --minify",
    "esbuild-webview": "npx esbuild client/src/debug/visualize/webview/main.ts --bundle --format=iife --target=es2022 --minify --outfile=out/debug/visualize-panel.webview.js",
    "copy-assets": "node ./scripts/copy-debug-assets.js",
    "compile": "npm run esbuild && npm run esbuild-webview && npm run copy-assets",
    "install": "cd client && npm install && cd ..",
    "watch": "npm run copy-assets && npm run esbuild-webview && npm run esbuild-base -- --sourcemap --watch",
    "lint": "npx eslint ./client/src/extension.ts",
    "compile:test": "tsc -p client",
    "test": "npm run compile:test && node ./scripts/e2e.js",
    "test:unit": "node -e \"require('fs').rmSync('client/out-unit',{recursive:true,force:true})\" && tsc -p client/tsconfig.unit.json && cd client/out-unit && node --test",
    "typecheck:webview": "tsc -p client/tsconfig.webview.json",
    "test:grammar": "vscode-tmgrammar-snap tests/cases/*",
    "fmt": "prettier . --write"
  },
  "dependencies": {
    "nushell-lsp-client": "file:client"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "25.5.2",
    "@types/tmp": "0.2.6",
    "@types/vscode": "1.110.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.28.0",
    "eslint": "^10.2.0",
    "mocha": "11.3.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "keywords": [
    "nushell",
    "nu",
    "shell",
    "scripting"
  ],
  "galleryBanner": {
    "color": "#008000",
    "theme": "light"
  }
}

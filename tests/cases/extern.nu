extern git [--verbose]
extern "git commit" [--amend]
extern --strict cargo [--verbose]
extern rustc --strict [--verbose]
export extern --strict rustup [--verbose]
extern --strict 'git log' [--oneline]
extern --strict `git diff` [--stat]
extern --strict "git status" [--short(-s)]
extern --strict=false foo [--a]
extern bar --strict=true [--a]
extern 'git.exe' [--x]
extern `git:log` [--x]
extern --strict=(true) baz [--x]
extern qux --strict=(not false) [--x]
const c = true; extern --strict=$c quux [--x]
extern "git \"x\"" [--a]
